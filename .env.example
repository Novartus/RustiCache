# ==============================================================================
# RustiCache Enterprise Environment Configuration
# ==============================================================================
# Copy this file to `.env` and adjust the variables to your needs:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Network & Server Settings
# ------------------------------------------------------------------------------
# Port the RustiCache server will bind and listen on.
# Default: 6379 (standard Redis port)
RUSTICACHE_PORT=6379

# Host address / network interface to bind to.
# Default: 0.0.0.0 (all interfaces)
RUSTICACHE_HOST=0.0.0.0

# TCP_NODELAY optimization (disables Nagle's algorithm for low latency).
# Default: true
RUSTICACHE_TCP_NODELAY=true

# Maximum concurrent client connections allowed (DoS protection).
# Default: 10000
RUSTICACHE_MAX_CONNECTIONS=10000

# Maximum single payload / frame size in bytes (anti-OOM buffer guard).
# Default: 536870912 (512 MB)
RUSTICACHE_MAX_PAYLOAD_SIZE_BYTES=536870912

# ------------------------------------------------------------------------------
# 2. Security & Authentication
# ------------------------------------------------------------------------------
# Require clients to authenticate with AUTH <password> before executing commands.
# Leave blank to disable authentication (open access).
RUSTICACHE_REQUIREPASS=

# Password for authenticating with the upstream Redis master when running as a replica.
RUSTICACHE_MASTERAUTH=

# ------------------------------------------------------------------------------
# 3. Concurrency & Multiprocessing
# ------------------------------------------------------------------------------
# Number of worker threads for the Tokio asynchronous multi-threaded runtime.
# Set to 0 to auto-detect and match available CPU cores.
# Default: 0
RUSTICACHE_WORKER_THREADS=0

# Number of concurrent storage partitions (must be a power of 2, e.g. 64, 128, 256).
# Reduces lock contention across multi-core systems.
# Default: 128
RUSTICACHE_SHARD_COUNT=128

# ------------------------------------------------------------------------------
# 4. Storage & Memory Optimization
# ------------------------------------------------------------------------------
# Maximum memory usage in bytes before LRU eviction triggers.
# Set to 0 for unlimited memory (eviction disabled).
# Default: 0
RUSTICACHE_MAXMEMORY_BYTES=0

# Background active TTL eviction frequency in milliseconds.
# Default: 100
RUSTICACHE_TTL_INTERVAL_MS=100

# Number of keys sampled per shard during each active eviction cycle.
# Default: 20
RUSTICACHE_TTL_SAMPLE_SIZE=20

# ------------------------------------------------------------------------------
# 5. Replication
# ------------------------------------------------------------------------------
# Leave blank to run as a standalone / Master Redis instance.
# To run as a replica syncing from an upstream master, specify: "<master_host> <master_port>"
# Example: RUSTICACHE_REPLICAOF="127.0.0.1 6379"
RUSTICACHE_REPLICAOF=

# ------------------------------------------------------------------------------
# 6. Redis Cluster Configuration
# ------------------------------------------------------------------------------
# Enable Redis Cluster horizontal sharding mode.
# Default: false
RUSTICACHE_CLUSTER_ENABLED=false

# Unique 40-character hexadecimal node ID (auto-generated if omitted).
RUSTICACHE_CLUSTER_NODE_ID=

# Announced IP and ports for client cluster redirection (-MOVED).
RUSTICACHE_CLUSTER_ANNOUNCE_IP=127.0.0.1
RUSTICACHE_CLUSTER_ANNOUNCE_PORT=6379
RUSTICACHE_CLUSTER_ANNOUNCE_BUS_PORT=16379

# Hash slots owned by this node (e.g. "0-5460", "5461-10922", "10923-16383", or "0-16383").
# Default: "0-16383" when cluster mode is enabled and unspecified.
RUSTICACHE_CLUSTER_SLOTS=

# ------------------------------------------------------------------------------
# 7. Logging & Observability
# ------------------------------------------------------------------------------
# Logging verbosity level (trace, debug, info, warn, error).
# Default: info
RUST_LOG=info

